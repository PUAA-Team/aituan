MYSQL_DATABASE=aituan_dev
MYSQL_USER=aituan
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 微服务独立数据库账号；每个账号只被授予自己 schema 的权限。
IDENTITY_DB_USERNAME=aituan_identity_svc
IDENTITY_DB_PASSWORD=change-me-identity
MERCHANT_DB_USERNAME=aituan_merchant_svc
MERCHANT_DB_PASSWORD=change-me-merchant
TRADE_DB_USERNAME=aituan_trade_svc
TRADE_DB_PASSWORD=change-me-trade
PLATFORM_DB_USERNAME=aituan_platform_svc
PLATFORM_DB_PASSWORD=change-me-platform

AITUAN_DATA_DIR=/opt/aituan/data
AITUAN_CONFIG_HOST_FILE=../.config

# CI/CD 镜像化部署专用变量；手动部署 docker-compose.server.yml 会忽略这些变量。
AITUAN_IMAGE_REGISTRY=ghcr.io/your-owner/your-repo
AITUAN_IMAGE_TAG=sha-example
AITUAN_DOWNLOADS_DIR=/opt/aituan/data/downloads

# Nginx HTTPS / Let's Encrypt 配置；真实服务器可保持这些默认路径。
AITUAN_NGINX_SERVER_NAME=aituan.2b.gs
AITUAN_LETSENCRYPT_DIR=/etc/letsencrypt
AITUAN_CERTBOT_WEBROOT=/var/www/certbot
