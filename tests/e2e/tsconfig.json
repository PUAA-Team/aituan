{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["playwright.config.ts", "specs/**/*.ts", "support/**/*.ts", "scripts/**/*.mjs"]
}
